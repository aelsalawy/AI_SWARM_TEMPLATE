{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Capability Registry Schema",
  "description": "Comprehensive schema for tracking agent capabilities, skills, and workload",
  
  "definitions": {
    "Skill": {
      "type": "object",
      "required": ["id", "name", "category", "proficiencyLevel"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Unique identifier for the skill (lowercase, alphanumeric with hyphens)"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Human-readable skill name"
        },
        "category": {
          "type": "string",
          "enum": [
            "programming",
            "testing", 
            "architecture",
            "devops",
            "documentation",
            "management",
            "design",
            "data",
            "security",
            "performance",
            "mobile",
            "web",
            "ai",
            "database"
          ],
          "description": "Primary category of the skill"
        },
        "proficiencyLevel": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced", "expert"],
          "description": "Proficiency level for this skill"
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "Brief description of the skill"
        },
        "relatedSkills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of related skill IDs"
        },
        "learningPath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Suggested learning progression for this skill"
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "issuer": {
                "type": "string",
                "maxLength": 100
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "expires": {
                "type": "boolean"
              },
              "expiryDate": {
                "type": ["string", "null"],
                "format": "date"
              }
            },
            "required": ["name", "issuer", "date"]
          },
          "description": "Professional certifications related to this skill"
        }
      }
    },
    
    "Agent": {
      "type": "object",
      "required": ["id", "name", "status", "skills", "maxConcurrentTasks"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^agent:[a-zA-Z0-9-]+$",
          "description": "Unique agent identifier (prefix: 'agent:')"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Human-readable agent name"
        },
        "emoji": {
          "type": "string",
          "maxLength": 10,
          "description": "Emoji representation of the agent"
        },
        "status": {
          "type": "string",
          "enum": ["online", "offline", "busy", "maintenance"],
          "description": "Current availability status of the agent"
        },
        "role": {
          "type": "string",
          "enum": [
            "senior-dev",
            "dev", 
            "ui-expert",
            "ui-dev",
            "qa",
            "devops",
            "architect",
            "manager"
          ],
          "description": "Primary role of the agent"
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Skill"
          },
          "description": "Array of skills possessed by the agent"
        },
        "specialties": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "performance",
              "security",
              "scalability",
              "mobile",
              "web",
              "cloud",
              "ai",
              "database",
              "frontend",
              "backend",
              "devops",
              "architecture"
            ]
          },
          "description": "Areas of specialization and expertise"
        },
        "maxConcurrentTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Maximum number of tasks the agent can handle simultaneously"
        },
        "preferredTaskTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bugfix",
              "feature",
              "refactor",
              "documentation",
              "testing",
              "architecture",
              "devops",
              "research",
              "optimization",
              "analysis"
            ]
          },
          "description": "Types of tasks the agent prefers to work on"
        },
        "workload": {
          "type": "object",
          "required": ["activeTasks", "recentCompletionRate"],
          "properties": {
            "activeTasks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "description": "Number of currently active tasks"
            },
            "recentCompletionRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Success rate over last 24 hours (0-1)"
            },
            "averageTaskDuration": {
              "type": "number",
              "minimum": 0,
              "description": "Average time to complete tasks in minutes"
            },
            "totalTasksCompleted": {
              "type": "integer",
              "minimum": 0,
              "description": "Total number of successfully completed tasks"
            },
            "totalTasksFailed": {
              "type": "integer",
              "minimum": 0,
              "description": "Total number of failed tasks"
            },
            "lastTaskCompleted": {
              "type": ["string", "null"],
              "format": "date-time",
              "description": "Timestamp of the last completed task"
            },
            "currentStreak": {
              "type": "integer",
              "minimum": 0,
              "description": "Consecutive successful task completions"
            },
            "averageResponseTime": {
              "type": "number",
              "minimum": 0,
              "description": "Average response time in seconds"
            },
            "taskDistribution": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              },
              "description": "Task distribution by type"
            }
          }
        },
        "rateLimit": {
          "type": "object",
          "required": ["requestsPerMinute", "modelType"],
          "properties": {
            "modelType": {
              "type": "string",
              "enum": [
                "nemotron-120b:free",
                "qwen3-coder:free", 
                "glm-4.5-flash",
                "glm-4.7-flash",
                "claude-3-opus",
                "gpt-4"
              ],
              "description": "AI model type and tier"
            },
            "requestsPerMinute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Current requests per minute count"
            },
            "dailyLimit": {
              "type": "integer",
              "minimum": 0,
              "description": "Daily request limit (if applicable)"
            },
            "lastReset": {
              "type": "string",
              "format": "date-time",
              "description": "Last time the rate limit was reset"
            },
            "usageHistory": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "requests": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": ["timestamp", "requests"]
              },
              "description": "Historical usage data"
            },
            "weeklyAverage": {
              "type": "number",
              "minimum": 0,
              "description": "Average requests per minute over the last week"
            }
          }
        },
        "preferences": {
          "type": "object",
          "properties": {
            "workHours": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dayOfWeek": {
                    "type": "string",
                    "enum": [
                      "monday", "tuesday", "wednesday", "thursday", 
                      "friday", "saturday", "sunday"
                    ]
                  },
                  "startTime": {
                    "type": "string",
                    "format": "time"
                  },
                  "endTime": {
                    "type": "string", 
                    "format": "time"
                  },
                  "timezone": {
                    "type": "string",
                    "description": "Timezone for this work period"
                  }
                },
                "required": ["dayOfWeek", "startTime", "endTime"]
              },
              "description": "Working hours by day of week"
            },
            "timezone": {
              "type": "string",
              "description": "Primary timezone (IANA identifier)"
            },
            "communicationPreferences": {
              "type": "object",
              "properties": {
                "notificationChannel": {
                  "type": "string",
                  "enum": ["slack", "email", "telegram", "none"],
                  "description": "Preferred notification channel"
                },
                "notificationFrequency": {
                  "type": "string",
                  "enum": ["immediate", "hourly", "daily", "none"],
                  "description": "Notification frequency preference"
                },
                "quietHours": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "startTime": {
                        "type": "string",
                        "format": "time"
                      },
                      "endTime": {
                        "type": "string",
                        "format": "time"
                      },
                      "days": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
                        }
                      }
                    }
                  },
                  "description": "Quiet periods when notifications should be minimized"
                }
              }
            },
            "taskPreferences": {
              "type": "object",
              "properties": {
                "minComplexity": {
                  "type": "string",
                  "enum": ["low", "medium", "high"],
                  "description": "Minimum complexity level to accept"
                },
                "maxComplexity": {
                  "type": "string", 
                  "enum": ["low", "medium", "high"],
                  "description": "Maximum complexity level to accept"
                },
                "estimatedDurationRange": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "Preferred task duration range in minutes [min, max]"
                }
              }
            }
          }
        },
        "performance": {
          "type": "object",
          "properties": {
            "averageResponseTime": {
              "type": "number",
              "minimum": 0,
              "description": "Average response time in seconds"
            },
            "successRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall success rate (0-1)"
            },
            "qualityScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Code quality score (0-1)"
            },
            "productivityScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Tasks completed per hour normalized"
            },
            "skillGrowthRate": {
              "type": "number",
              "minimum": 0,
              "description": "Rate of skill improvement over time"
            },
            "peerRatings": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "description": "Peer ratings for collaboration quality"
            }
          }
        },
        "availability": {
          "type": "object",
          "properties": {
            "nextAvailableTime": {
              "type": ["string", "null"],
              "format": "date-time",
              "description": "Next time the agent will be available"
            },
            "currentCapacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Current capacity utilization (0-1)"
            },
            "capacityTrend": {
              "type": "string",
              "enum": ["increasing", "stable", "decreasing"],
              "description": "Current capacity utilization trend"
            },
            "availabilityForecast": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "capacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "description": "Capacity forecast for upcoming days"
            }
          }
        },
        "history": {
          "type": "object",
          "properties": {
            "joinedAt": {
              "type": "string",
              "format": "date-time",
              "description": "When the agent first joined the swarm"
            },
            "lastActivity": {
              "type": "string",
              "format": "date-time",
              "description": "Last activity timestamp"
            },
            "totalWorkHours": {
              "type": "number",
              "minimum": 0,
              "description": "Total work hours logged"
            },
            "achievements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "earnedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "description": "Agent achievements and milestones"
            }
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
              "description": "Schema version"
            },
            "lastUpdated": {
              "type": "string",
              "format": "date-time",
              "description": "Last timestamp when agent data was updated"
            },
            "source": {
              "type": "string",
              "enum": ["manual", "auto-detected", "imported"],
              "description": "How the agent information was sourced"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Additional tags for categorization"
            }
          }
        }
      }
    },
    
    "SkillDistribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Distribution of skills across the agent population"
    },
    
    "TeamComposition": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Composition breakdown by agent role"
    },
    
    "RegistryMetadata": {
      "type": "object",
      "required": ["lastUpdated", "version"],
      "properties": {
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Last time the registry was updated"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Registry schema version"
        },
        "totalAgents": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of agents in the registry"
        },
        "totalSkills": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of unique skills in the registry"
        },
        "totalActiveAgents": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of currently active agents"
        },
        "systemHealth": {
          "type": "object",
          "properties": {
            "lastSync": {
              "type": "string",
              "format": "date-time",
              "description": "Last successful synchronization timestamp"
            },
            "validationErrors": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of validation errors"
            },
            "performance": {
              "type": "object",
              "properties": {
                "averageQueryTime": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Average query response time in milliseconds"
                },
                "cacheHitRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Cache hit rate (0-1)"
                }
              }
            }
          }
        }
      }
    }
  },
  
  "type": "object",
  "required": ["agents", "skills", "metadata"],
  "properties": {
    "agents": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Agent"
      },
      "description": "Collection of all agents in the swarm",
      "minProperties": 1,
      "patternProperties": {
        "^agent:[a-zA-Z0-9-]+$": {
          "$ref": "#/definitions/Agent"
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Skill"
      },
      "description": "Collection of all defined skills",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "$ref": "#/definitions/Skill"
        }
      }
    },
    "metadata": {
      "$ref": "#/definitions/RegistryMetadata",
      "description": "Registry metadata and system information"
    },
    "analytics": {
      "type": "object",
      "properties": {
        "skillDistribution": {
          "$ref": "#/definitions/SkillDistribution"
        },
        "teamComposition": {
          "$ref": "#/definitions/TeamComposition"
        },
        "capacityUtilization": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "Capacity utilization by agent"
        },
        "performanceMetrics": {
          "type": "object",
          "properties": {
            "averageResponseTime": {
              "type": "number",
              "minimum": 0
            },
            "successRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "throughput": {
              "type": "number",
              "minimum": 0,
              "description": "Tasks completed per hour"
            }
          }
        }
      },
      "description": "Analytics and summary data"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "maxConcurrentAgents": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of concurrent agents allowed"
        },
        "skillProficiencyValidation": {
          "type": "boolean",
          "description": "Whether to validate skill proficiency claims"
        },
        "requiredFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Required fields for all agents"
        },
        "validationRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "description": "Custom validation rules"
        }
      },
      "description": "System constraints and validation rules"
    }
  },
  "additionalProperties": false
}