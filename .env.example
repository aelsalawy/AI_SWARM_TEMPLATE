# Environment Configuration

Copy this file to `.env` and fill in your values.

## Server Basic
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL="postgresql://user:password@localhost:5432/alm_db?schema=public"
JWT_SECRET="generate-a-long-random-string-here"

## OAuth (Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
API_BASE_URL=http://localhost:3001

## Email Service (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_username
SMTP_PASS=your_password
EMAIL_FROM=noreply@yourdomain.com

## Agent Orchestration (Dispatch)
# 'pm' (PM-mediated) or 'direct' (auto-dispatch)
DISPATCH_MODE=pm
# IDs of agents allowed to dispatch tasks (comma-separated)
DISPATCHER_AGENT_IDS=agent:pm
# IDs of agents allowed to be assigned/spawned (comma-separated)
TRIGGER_ENABLED_AGENTS=agent:seniordev,agent:dev
# The primary PM agent ID
PM_AGENT_ID=agent:pm
# Target for escalation when PM is unresponsive
ESCALATION_AGENT_ID=agent:cto

# Timing & Limits
PM_NO_ACT_MINUTES=15
PM_NUDGE_MAX=2
PM_DISPATCH_PER_MINUTE=10
ASSIGNEE_IN_FLIGHT_CAP=3

# API links provided to agents
ALM_BASE_URL=http://localhost:3001

## Agent Gateway (Spawn Bridge)
# Required if using the spawn bridge to wake agents
OPENCLAW_GATEWAY_URL=https://gateway.yourdomain.com
OPENCLAW_GATEWAY_TOKEN=your_gateway_token
GATEWAY_SPAWN_TIMEOUT_SEC=60

## Legacy / Break-glass
# Shared key for machine-to-machine access (use with caution)
AGENT_API_KEY=your_secret_agent_key
